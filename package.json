{
  "name": "monorepo",
  "private": true,
  "description": "A minimalistic routing for React and Preact. Monorepo package.",
  "type": "module",
  "workspaces": [
    "packages/wouter"
  ],
  "scripts": {
    "fix:p": "prettier --write \"./**/*.(js|ts){x,}\"",
    "test": "vitest",
    "size": "size-limit",
    "build": "npm run build -ws",
    "watch": "concurrently -n wouter,wouter-preact \"npm run -w packages/wouter watch\" \"npm run -w packages/wouter-preact watch\"",
    "lint": "eslint packages/**/*.js",
    "lint-types": "vitest --typecheck"
  },
  "author": "Alexey Taktarov <molefrog@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molefrog/wouter.git"
  },
  "license": "ISC",
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "printWidth": 80
  },
  "size-limit": [
    {
      "path": "packages/wouter/esm/index.js",
      "limit": "2500 B",
      "ignore": [
        "react",
        "use-sync-external-store"
      ]
    },
    {
      "path": "packages/wouter/esm/use-browser-location.js",
      "limit": "1000 B",
      "import": "{ useBrowserLocation }",
      "ignore": [
        "react",
        "use-sync-external-store"
      ]
    },
    {
      "path": "packages/wouter/esm/memory-location.js",
      "limit": "1000 B",
      "ignore": [
        "react",
        "use-sync-external-store"
      ]
    },
    {
      "path": "packages/wouter/esm/use-hash-location.js",
      "limit": "1000 B",
      "ignore": [
        "react",
        "use-sync-external-store"
      ]
    },
    {
      "path": "packages/wouter-preact/esm/index.js",
      "limit": "2500 B",
      "ignore": [
        "preact",
        "preact/hooks"
      ]
    },
    {
      "path": "packages/wouter-preact/esm/use-browser-location.js",
      "limit": "1000 B",
      "import": "{ useBrowserLocation }",
      "ignore": [
        "preact",
        "preact/hooks"
      ]
    },
    {
      "path": "packages/wouter-preact/esm/use-hash-location.js",
      "limit": "1000 B",
      "ignore": [
        "preact",
        "preact/hooks"
      ]
    },
    {
      "path": "packages/wouter-preact/esm/memory-location.js",
      "limit": "1000 B",
      "ignore": [
        "preact",
        "preact/hooks"
      ]
    }
  ],
  "husky": {
    "hooks": {
      "commit-msg": "npm run fix:p"
    }
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "parserOptions": {
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "env": {
      "es2020": true,
      "browser": true,
      "node": true
    },
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "varsIgnorePattern": "^_",
          "argsIgnorePattern": "^_"
        }
      ],
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn"
    },
    "plugins": [
      "react-hooks"
    ],
    "ignorePatterns": [
      "types/**"
    ]
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@rollup/plugin-alias": "^5.0.0",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-replace": "^5.0.7",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.2.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^4.0.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.0.8",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "eslint": "^7.19.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^4.3.0",
    "mitt": "^3.0.1",
    "path-to-regexp": "^6.2.1",
    "playwright": "^1.55.0",
    "prettier": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "regexparam": "^3.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^3.29.5",
    "size-limit": "^10.0.1",
    "typescript": "5.2.2",
    "use-sync-external-store": "^1.5.0",
    "vitest": "^3.0.8",
    "vitest-browser-react": "^1.0.1"
  }
}
